# /etc/hosts — identical on all five nodes
127.0.0.1       localhost
127.0.1.1       $(hostname)

# 192.168.100.0/24 — management and flat provider network (same L2)
192.168.100.24  controller
192.168.100.25  compute1
192.168.100.26  compute2
192.168.100.27  block
192.168.100.28  object

# IPv6 defaults
::1             localhost ip6-localhost ip6-loopback
ff02::1         ip6-allnodes
ff02::2         ip6-allrouters
